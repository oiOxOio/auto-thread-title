{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/run.sh\" hook",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'scripts/run.ps1') hook\"",
            "timeout": 10,
            "additionalContextLimit": 1400
          }
        ]
      }
    ]
  }
}
