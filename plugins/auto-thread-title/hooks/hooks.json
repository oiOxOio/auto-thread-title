{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','session_start.py'),run_name='__main__')\"",
            "commandWindows": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','session_start.py'),run_name='__main__')\"",
            "timeout": 5,
            "additionalContextLimit": 1400
          }
        ]
      }
    ]
  }
}
